# --- core ---
DATABASE_URL=postgres://localhost/craigsnotice
PORT=8022
# Comma-separated browser origins allowed to call the API.
APP_ORIGINS=http://localhost:5173

# Public URL Bright Data can reach, so it POSTs finished runs to us instead of
# us polling. Localhost is not reachable from their servers — use a tunnel:
#   cloudflared tunnel --url http://localhost:8022
# Leave blank to poll instead (no inbound connectivity needed).
PUBLIC_BASE_URL=
DEMO_MODE=live

# --- Firebase (auth + web push) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_VAPID_KEY=

# --- Bright Data Scraper Studio ---
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SEARCH_COLLECTOR=
BRIGHTDATA_DETAIL_COLLECTOR=

# --- Port ---
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_DEAL_AGENT_ID=

# --- SigNoz / OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.us.signoz.cloud:443
OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=
OTEL_SERVICE_NAME=craigsnotice-api
# Shared secret SigNoz must send as x-signoz-token on the heal webhook.
# The /api/v1/hooks route is NOT mounted unless this is set.
SIGNOZ_WEBHOOK_SECRET=

# --- tuning ---
WATCH_DEFAULT_INTERVAL_SEC=300
MIN_BASELINE_SAMPLES=5
VIOLATION_RATE_THRESHOLD=0.3

# --- dev only: guards /api/v1/debug/* ---
DEBUG_TOKEN=
